      <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="{ThemeResource OpsCardBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OpsTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OpsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style x:Key="OpsPrimaryButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{ThemeResource OpsAccentSurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OpsAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
      <Style x:Key="OpsNavigationStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource OpsMutedBrush}" />
      </Style>
      <Style x:Key="OpsNavigationSelectedStyle" TargetType="Button" BasedOn="{StaticResource OpsNavigationStyle}">
        <Setter Property="Background" Value="{ThemeResource OpsAccentSurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OpsAccentBrush}" />
      </Style>

</ResourceDictionary>
