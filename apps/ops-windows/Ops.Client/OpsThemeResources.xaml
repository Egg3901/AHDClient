          <SolidColorBrush x:Key="OpsReviewBrush" Color="#956515" />
          <SolidColorBrush x:Key="OpsReviewSurfaceBrush" Color="#FFF0CF" />
          <SolidColorBrush x:Key="OpsBlueBrush" Color="#3E62B5" />
          <SolidColorBrush x:Key="OpsBlueSurfaceBrush" Color="#E8EEFE" />
          <SolidColorBrush x:Key="OpsPurpleBrush" Color="#8554B4" />
          <SolidColorBrush x:Key="OpsPurpleSurfaceBrush" Color="#F1E8FA" />
