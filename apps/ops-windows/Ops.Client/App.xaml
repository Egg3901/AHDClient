<Application x:Class="Ops.Client.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="OpsCanvasBrush" Color="#F7F8FA" />
          <SolidColorBrush x:Key="OpsSidebarBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OpsCardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OpsLaneBrush" Color="#EFF2F5" />
          <SolidColorBrush x:Key="OpsBorderBrush" Color="#DEE4EA" />
          <SolidColorBrush x:Key="OpsTextBrush" Color="#172B3A" />
          <SolidColorBrush x:Key="OpsMutedBrush" Color="#607284" />
          <SolidColorBrush x:Key="OpsAccentBrush" Color="#086F69" />
          <SolidColorBrush x:Key="OpsAccentSurfaceBrush" Color="#E1F3EE" />
          <SolidColorBrush x:Key="OpsReviewBrush" Color="#956515" />
          <SolidColorBrush x:Key="OpsReviewSurfaceBrush" Color="#FFF0CF" />
          <SolidColorBrush x:Key="OpsBlueBrush" Color="#3E62B5" />
          <SolidColorBrush x:Key="OpsBlueSurfaceBrush" Color="#E8EEFE" />
          <SolidColorBrush x:Key="OpsPurpleBrush" Color="#8554B4" />
          <SolidColorBrush x:Key="OpsPurpleSurfaceBrush" Color="#F1E8FA" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="OpsCanvasBrush" Color="#10181F" />
          <SolidColorBrush x:Key="OpsSidebarBrush" Color="#141F28" />
          <SolidColorBrush x:Key="OpsCardBrush" Color="#20303C" />
          <SolidColorBrush x:Key="OpsLaneBrush" Color="#17242E" />
          <SolidColorBrush x:Key="OpsBorderBrush" Color="#30424F" />
          <SolidColorBrush x:Key="OpsTextBrush" Color="#ECF3F6" />
          <SolidColorBrush x:Key="OpsMutedBrush" Color="#A4B8C5" />
          <SolidColorBrush x:Key="OpsAccentBrush" Color="#73D4B7" />
          <SolidColorBrush x:Key="OpsAccentSurfaceBrush" Color="#1D423E" />
          <SolidColorBrush x:Key="OpsReviewBrush" Color="#F2CC7D" />
          <SolidColorBrush x:Key="OpsReviewSurfaceBrush" Color="#473D29" />
          <SolidColorBrush x:Key="OpsBlueBrush" Color="#A2BBFF" />
          <SolidColorBrush x:Key="OpsBlueSurfaceBrush" Color="#293A58" />
          <SolidColorBrush x:Key="OpsPurpleBrush" Color="#D8B2FF" />
          <SolidColorBrush x:Key="OpsPurpleSurfaceBrush" Color="#41314D" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="OpsCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="OpsSidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="OpsCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="OpsLaneBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="OpsBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="OpsTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="OpsMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="OpsAccentBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="OpsAccentSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="OpsReviewBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="OpsReviewSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="OpsBlueBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="OpsBlueSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="OpsPurpleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="OpsPurpleSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="{ThemeResource OpsCardBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OpsTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OpsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style x:Key="OpsPrimaryButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{ThemeResource OpsAccentSurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OpsAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
      <Style x:Key="OpsNavigationStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource OpsMutedBrush}" />
      </Style>
      <Style x:Key="OpsNavigationSelectedStyle" TargetType="Button" BasedOn="{StaticResource OpsNavigationStyle}">
        <Setter Property="Background" Value="{ThemeResource OpsAccentSurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OpsAccentBrush}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
