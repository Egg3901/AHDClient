<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>AHDWidgetKeychainGroup</key>
  <string>$(AppIdentifierPrefix)net.lakesidegames.ahdclient.widgets</string>
  <key>CFBundleURLTypes</key>
  <array><dict><key>CFBundleURLName</key><string>net.lakesidegames.ahdclient.briefing</string>
    <key>CFBundleURLSchemes</key><array><string>ahdclient</string></array>
  </dict></array>
  <!-- Merged into the generated iOS Info.plist by the Tauri CLI. -->
  <!-- The launcher and the game are dark; keep the status bar text light. -->
  <key>UIUserInterfaceStyle</key>
  <string>Dark</string>
  <!-- Only HTTPS to the game; no proprietary encryption, so no export
       compliance questionnaire on every TestFlight upload. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
</dict>
</plist>
