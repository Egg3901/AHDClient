{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A House Divided: Solo",
  "version": "0.1.0",
  "identifier": "net.lakesidegames.ahdsolo",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "A House Divided: Solo",
        "width": 1280,
        "height": 800,
        "backgroundColor": "#0a0a0a",
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
