{
  "cli": {
    "version": ">=23.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "environment": "production",
      "distribution": "store",
      "withoutCredentials": true,
      "ios": {
        "config": "ops-release.yml",
        "image": "latest",
        "resourceClass": "m-medium"
      }
    },
    "preflight": {
      "extends": "production",
      "ios": {
        "config": "preflight.yml"
      }
    },
    "ahdclient-production": {
      "environment": "production",
      "distribution": "store",
      "withoutCredentials": true,
      "config": "ahdclient-release.yml",
      "ios": {
        "image": "latest",
        "resourceClass": "m-medium"
      }
    },
    "delivery-status": {
      "extends": "production",
      "ios": {
        "config": "delivery-status.yml"
      }
    },
    "delivery-invite": {
      "extends": "production",
      "ios": {
        "config": "delivery-invite.yml"
      }
    }
  }
}
